<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>S3 File Manager</masterLabel>
    <description>Upload, download, preview, and delete files stored in Amazon S3 for a record.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__UtilityBar</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <!-- Record pages supply recordId automatically. -->
        <targetConfig targets="lightning__RecordPage">
            <property name="cardTitle" type="String" label="Card Title" default="Files (S3)" />
        </targetConfig>
        <targetConfig targets="lightning__AppPage,lightning__HomePage,lightning__UtilityBar">
            <property name="cardTitle" type="String" label="Card Title" default="Files (S3)" />
            <property name="recordId" type="String" label="Record Id"
                description="Id of the record whose files are shown. These pages have no record context, so it must be set here." />
        </targetConfig>
        <targetConfig targets="lightningCommunity__Default">
            <property name="cardTitle" type="String" label="Card Title" default="Files (S3)" />
            <property name="recordId" type="String" label="Record Id" default="{!recordId}"
                description="Defaults to the record of the current page. Set a fixed Id on pages without a record." />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>